APP_NAME=go-gin-boilerplate
APP_ENV=development
APP_PORT=8080
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For (empty = trust none)
TRUSTED_PROXIES=
# Comma-separated origins allowed for browser requests (empty = "*" in development, none in production)
CORS_ALLOWED_ORIGINS=
# Expose /swagger (default: true outside production)
# SWAGGER_ENABLED=true

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_gin_boilerplate
DB_SSLMODE=disable

# JWT
# Must be a random value of at least 32 characters in production, e.g. `openssl rand -hex 32`
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_EXPIRE_HOURS=1
JWT_REFRESH_EXPIRE_DAYS=7
